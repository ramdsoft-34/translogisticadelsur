# Copie este archivo como .env y ajuste los valores.
PORT=4000
# 127.0.0.1 en producción (la API solo se publica a través de nginx)
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/translogisticadelsur
# Cadena larga y aleatoria (mínimo 32 caracteres). Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h
# Orígenes permitidos para el frontend, separados por coma
CORS_ORIGINS=http://localhost:4250,http://localhost:4200

# SuperAdmin inicial (solo lo usa `npm run seed` si no existe ninguno)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NOMBRE=Super Administrador

# RNDC (Ministerio de Transporte). Ver docs/RNDC.md
# Simulador local para validar sin tocar el RNDC real (npm run simulador)
RNDC_SIMULADOR_URL=http://127.0.0.1:4010/soap/IBPMServices
# Solo con "true" el sistema permite enviar al ambiente de PRODUCCION del RNDC
RNDC_PERMITIR_PRODUCCION=false
# Solo con "true" permite usar el ambiente oficial de PRUEBAS (plc.mintransporte.gov.co)
RNDC_PERMITIR_PRUEBAS=true
RNDC_TIMEOUT_MS=90000
# Llave maestra (exclusiva) para guardar cifrada la contraseña del RNDC. Mejor en un archivo solo legible por
# root, fuera del repositorio: openssl rand -base64 32 > /etc/translogistica/rndc.key && chmod 400 ...
# Sin llave no se puede guardar la contraseña (se sigue escribiendo en cada envío).
RNDC_LLAVE_ARCHIVO=
# RNDC_LLAVE_MAESTRA=   (alternativa: la llave en base64 directamente en el entorno)
# Protección del web service del RNDC (no aplica al simulador)
RNDC_MAX_CONCURRENTES=1
RNDC_PAUSA_MS=1000
# Pausa entre placas al actualizar vehículos de forma masiva
RNDC_PAUSA_MASIVA_MS=1500

# Archivo de cada empresa: copias al cerrar el mes, informes y PDF de manifiestos (por defecto backend/archivo)
ARCHIVO_DIR=
