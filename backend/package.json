  "private": true,
  "description": "API multiempresa de Translogística del Sur: viajes, maestros, RNDC y liquidación de fletes",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
